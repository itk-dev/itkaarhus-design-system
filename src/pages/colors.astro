  .brand-card .chip .role { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; color: var(--itkaarhus-white); opacity: 0.9; }
  .brand-card .meta { padding: 16px 18px; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
