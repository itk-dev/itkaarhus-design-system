  /* Scale row: 10 steps. Labels sit on fixed palette colours, so they stay raw. */
  .scale { display: grid; grid-template-columns: repeat(10, 1fr); border-radius: 8px; overflow: hidden; border: 1px solid var(--itkaarhus-border); }
  .scale .step { aspect-ratio: 1/1.5; background: var(--c); display: flex; flex-direction: column; justify-content: flex-end; gap: 2px; padding: 8px 6px; font-family: var(--itkaarhus-font-mono); font-size: 10px; color: var(--itkaarhus-white); }
