  .h3 { font-size: 16px; font-weight: 600; margin: 40px 0 12px; }
  .rules { margin: 0; padding: 0 0 0 18px; max-width: 720px; display: grid; gap: 10px; font-size: 14px; line-height: 1.55; color: var(--itkaarhus-text-muted); }
  .rules b { color: var(--itkaarhus-text); font-weight: 600; }

  /* State demo alerts — depict the raw scale steps named in the copy (light usage). */
  .states { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 8px; }
  .alert { display: flex; gap: 12px; padding: 14px 16px; border-radius: 8px; font-size: 14px; line-height: 1.5; border: 1px solid transparent; }
