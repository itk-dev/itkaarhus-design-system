  .ucard ul { margin: 0; padding: 0; list-style: none; }
  .ucard li { padding: 10px 0; border-top: 1px solid var(--itkaarhus-border-subtle); font-size: 14px; color: var(--itkaarhus-text-muted); line-height: 1.5; }
  .ucard li:first-child { border-top: 0; padding-top: 0; }
  .ucard li b { color: var(--itkaarhus-text); font-weight: 600; }

  /* Semantic tokens — each swatch cell is a light or dark island (data-theme),
     so both values show side by side whatever the page theme is. */
  .themes { width: 100%; border-collapse: collapse; margin-top: 8px; }
  .themes thead th { text-align: left; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--itkaarhus-text-subtle); font-weight: 600; padding: 0 12px 10px 0; border-bottom: 1px solid var(--itkaarhus-border); }
  .themes .grp th { text-align: left; padding: 28px 0 8px; font-size: 14px; font-weight: 600; color: var(--itkaarhus-text); border-bottom: 1px solid var(--itkaarhus-border); }
  .themes td { padding: 8px 12px 8px 0; border-bottom: 1px solid var(--itkaarhus-border-subtle); font-size: 14px; color: var(--itkaarhus-text-muted); vertical-align: middle; }
  .themes td.tk { width: 240px; font-family: var(--itkaarhus-font-mono); font-size: 12px; color: var(--itkaarhus-text); line-height: 1.6; }
  .themes td.use { font-size: 13px; }
  .tw { display: flex; align-items: center; gap: 10px; min-width: 190px; padding: 8px 10px; border-radius: var(--itkaarhus-radius-2); border: 1px solid var(--itkaarhus-border); background: var(--itkaarhus-bg); color: var(--itkaarhus-text); }
