  .scale-label .tok { font-family: var(--itkaarhus-font-mono); font-size: 12px; color: var(--itkaarhus-text-subtle); }

  /* Usage */
  .usage { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 8px; }
  .ucard { border: 1px solid var(--itkaarhus-border); border-radius: 10px; padding: 22px; }
  .ucard.do { border-left: 3px solid var(--itkaarhus-success); }
