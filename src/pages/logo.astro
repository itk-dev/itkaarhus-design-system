---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Logo & brand">
  <div class="page">
    <div class="eyebrow">Brand · Logo &amp; endorsement</div>
    <h1 class="title">Aarhus Kommune leads, the product names itself.</h1>
    <p class="lede">Aarhus Kommune is the institutional brand — present, but quiet. It signs each product as a footer endorsement rather than a banner. In the header, a small emblem pairs with the product's own name.</p>

    <h2 class="sh">Endorsement mark — Aarhus Kommune</h2>
    <p class="note">The official Aarhus Kommune mark. Use it small and low — a footer endorsement that says who stands behind the product. Don't recreate it; always use the supplied SVGs.</p>
    <div class="variants">
      <div class="var color">
        <div class="box"><img src={`${base}assets/logos/AAK_02_venstrejusteret_sh.svg`} alt="Aarhus Kommune, mørk" /></div>
        <div class="cap">Mørk · on light <span>AAK_02_venstrejusteret_sh.svg</span></div>
      </div>
      <div class="var white">
        <div class="box"><img src={`${base}assets/logos/AAK_02_venstrejusteret_hvid.svg`} alt="Aarhus Kommune, hvid" /></div>
        <div class="cap" style="background:var(--itkaarhus-gray-900); color:#fff; border-color:#333">Hvid · on dark <span style="color:#888">AAK_02_venstrejusteret_hvid.svg</span></div>
      </div>
      <div class="var color">
        <div class="box"><img src={`${base}assets/logos/AAK_02_hoejrejusteret_dark.svg`} alt="Aarhus Kommune, højrejusteret" /></div>
        <div class="cap">Højrejusteret <span>AAK_02_hoejrejusteret_dark.svg</span></div>
      </div>
    </div>

    <h2 class="sh">Product header lockup</h2>
    <p class="note">Each product signs its chrome with a small emblem plus its own name — not the Aarhus Kommune logo, not a legacy wordmark. The emblem here is the Aarhus Kommune crest; <code>[Product name]</code> is a placeholder you swap per product.</p>
    <div class="lockup">
      <img class="itkaarhus-light-only" src={`${base}assets/logos/aak-favicon.ico`} alt="Emblem" />
      <img class="itkaarhus-dark-only" src={`${base}assets/logos/aak-emblem-hvid.svg`} alt="Emblem" />
      <span class="product">[Product name]</span>
    </div>

    <h2 class="sh" id="dark">Logos in the dark theme</h2>
    <p class="note">The marks are never recoloured — a dark surface gets the white (<code>-hvid</code>) file. Both header emblems ship in the Composer package under <code>assets/logos/</code>; the white emblem-only mark is <code>aak-emblem-hvid.svg</code>. Where one surface is light in one theme and dark in the other, include both files and toggle them with <code>.itkaarhus-light-only</code> / <code>.itkaarhus-dark-only</code> from <code>components.css</code>.</p>
    <div class="dark-demo">
      {
        ['light', 'dark'].map((theme) => (
          <div class="dark-demo__pane" data-theme={theme}>
            <span class="dark-demo__label">{theme === 'light' ? 'Light theme' : 'Dark theme'}</span>
            <div class="dark-demo__header">
              <img class="itkaarhus-light-only" src={`${base}assets/logos/aak-emblem.svg`} alt="" height="28" />
              <img class="itkaarhus-dark-only" src={`${base}assets/logos/aak-emblem-hvid.svg`} alt="" height="28" />
              <span class="product">[Product name]</span>
            </div>
          </div>
        ))
      }
    </div>
    <table class="logo-map">
      <thead><tr><th>Surface</th><th>Header emblem</th><th>Footer endorsement</th></tr></thead>
      <tbody>
        <tr>
          <td>Light surfaces — <code>bg</code>, <code>bg-muted</code>, <code>bg-raised</code> in light</td>
          <td><code>aak-emblem.svg</code></td>
          <td><code>AAK_02_venstrejusteret_sh.svg</code></td>
        </tr>
        <tr>
          <td>Dark surfaces — the same tokens in dark</td>
          <td><code>aak-emblem-hvid.svg</code></td>
          <td><code>AAK_02_venstrejusteret_hvid.svg</code></td>
        </tr>
        <tr>
          <td><code>bg-inverse</code> (footer, CTA) — dark in both themes</td>
          <td><code>aak-emblem-hvid.svg</code></td>
          <td><code>AAK_02_venstrejusteret_hvid.svg</code> — no swap needed</td>
        </tr>
      </tbody>
    </table>
    <p class="note" style="margin-top:16px">The right-aligned mark (<code>AAK_02_hoejrejusteret_dark.svg</code>) has no white variant — keep it to light surfaces. The <code>aak-favicon.ico</code> crest is dark, so on dark surfaces swap it for <code>aak-emblem-hvid.svg</code> as in the lockup above. The <code>AAK_02_*</code> endorsement files live in this site (<code>public/assets/logos/</code>) and are not part of the Composer package; only the two emblems are.</p>

    <h2 class="sh">Clear space &amp; minimum size</h2>
    <div class="clearspace">
      <div class="rel">
        <img src={`${base}assets/logos/AAK_02_venstrejusteret_sh.svg`} alt="Aarhus Kommune mark med frizone" />
      </div>
    </div>
    <p class="note" style="margin: 12px 0 0; max-width: none">Minimum clear space equals 25 % of the mark's height on every side. Keep the endorsement small and unobtrusive — it confirms ownership, it doesn't headline.</p>

    <h2 class="sh">Do not</h2>
    <div class="misuse">
      <div class="m"><div class="mbox stretch"><img src={`${base}assets/logos/AAK_02_venstrejusteret_sh.svg`} alt="" /></div><div class="cap">Don't stretch</div></div>
      <div class="m tint"><div class="mbox"><img src={`${base}assets/logos/AAK_02_venstrejusteret_sh.svg`} alt="" /></div><div class="cap">Don't recolour</div></div>
      <div class="m bg"><div class="mbox"><img src={`${base}assets/logos/AAK_02_venstrejusteret_hvid.svg`} alt="" /></div><div class="cap">Don't place on busy backgrounds</div></div>
      <div class="m shadow"><div class="mbox"><img src={`${base}assets/logos/AAK_02_venstrejusteret_sh.svg`} alt="" /></div><div class="cap">Don't add effects</div></div>
    </div>

    <h2 class="sh">Footer endorsement in context</h2>
    <p class="note">How the Aarhus Kommune mark sits in a product footer: small, low, quiet — confirming ownership without competing with the product name.</p>
    <div class="cobrand">
      <div class="cobox">
        <div style="font-size:13px; line-height:1.4; opacity:.7">[Product name]<br /><span style="opacity:.7">En del af</span></div>
        <div class="div"></div>
        <img src={`${base}assets/logos/AAK_02_venstrejusteret_hvid.svg`} alt="Aarhus Kommune" />
      </div>
      <div class="cobox inv">
        <div style="font-size:13px; line-height:1.4; color:var(--itkaarhus-gray-500)">[Product name]<br /><span>En del af</span></div>
        <div class="div"></div>
        <img src={`${base}assets/logos/AAK_02_venstrejusteret_sh.svg`} alt="Aarhus Kommune" />
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Boxes that DEPICT a mark on a light or dark ground keep fixed raw colours
     (white, gray-50, gray-900), so each example stays correct in both themes. */
  .page { max-width: 1040px; margin: 0 auto; padding: 48px; }
  .eyebrow { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--itkaarhus-text-subtle); font-weight: 600; }
  h1.title { font-size: 44px; line-height: 1.05; margin: 8px 0 16px; letter-spacing: -0.02em; font-weight: 700; }
  p.lede { font-size: 18px; color: var(--itkaarhus-text-muted); max-width: 640px; margin: 0 0 40px; }
  h2.sh { font-size: 22px; margin: 48px 0 20px; font-weight: 600; letter-spacing: -0.01em; scroll-margin-top: 24px; }
  .note { font-size: 14px; color: var(--itkaarhus-text-subtle); margin: -8px 0 16px; max-width: 640px; }

  /* Product header lockup — emblem + product name */
  .lockup { border: 1px solid var(--itkaarhus-border); border-radius: 12px; padding: 40px; display: flex; align-items: center; gap: 14px; background: var(--itkaarhus-bg-raised); }
  .lockup img { width: 40px; height: 40px; border-radius: var(--itkaarhus-radius-2); object-fit: contain; }
  .lockup .product { font-family: var(--itkaarhus-font-display); font-size: 24px; font-weight: 600; letter-spacing: -0.015em; color: var(--itkaarhus-text); }

  .variants { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .var { border: 1px solid var(--itkaarhus-border); border-radius: 10px; overflow: hidden; background: var(--itkaarhus-bg-raised); }
  .var .box { aspect-ratio: 16/10; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .var.white .box { background: var(--itkaarhus-gray-900); }
  .var.color .box { background: var(--itkaarhus-white); }
  .var img { max-width: 65%; max-height: 80%; object-fit: contain; }
  .var .cap { padding: 12px 16px; border-top: 1px solid var(--itkaarhus-border); font-size: 12px; color: var(--itkaarhus-text-muted); display: flex; justify-content: space-between; }
  .var .cap span { font-family: var(--itkaarhus-font-mono); color: var(--itkaarhus-text-subtle); font-size: 11px; }

  /* Dark-theme logo swap demo — each pane is a light or dark island */
  .dark-demo { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .dark-demo__pane { border: 1px solid var(--itkaarhus-border); border-radius: 12px; padding: 20px 24px 28px; background: var(--itkaarhus-bg); color: var(--itkaarhus-text); }
  .dark-demo__label { display: block; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--itkaarhus-text-subtle); margin-bottom: 16px; }
  .dark-demo__header { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border: 1px solid var(--itkaarhus-border); border-radius: 8px; background: var(--itkaarhus-bg-raised); }
  .dark-demo__header img { height: 28px; width: auto; }
  .dark-demo__header .product { font-family: var(--itkaarhus-font-display); font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }
  /* The visibility utilities key on the page theme; inside an island, follow the island. */
  .dark-demo__pane[data-theme="light"] .itkaarhus-dark-only,
  .dark-demo__pane[data-theme="dark"] .itkaarhus-light-only { display: none !important; }
  .dark-demo__pane[data-theme="light"] .itkaarhus-light-only,
  .dark-demo__pane[data-theme="dark"] .itkaarhus-dark-only { display: inline !important; }

  .logo-map { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 14px; }
  .logo-map th { text-align: left; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--itkaarhus-text-subtle); font-weight: 600; padding: 0 12px 10px 0; border-bottom: 1px solid var(--itkaarhus-border); }
  .logo-map td { padding: 12px 12px 12px 0; border-bottom: 1px solid var(--itkaarhus-border-subtle); color: var(--itkaarhus-text-muted); vertical-align: top; }
  .logo-map td code { color: var(--itkaarhus-text); }

  .misuse { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .m { border: 1px solid var(--itkaarhus-border); border-radius: 10px; overflow: hidden; }
  .m .mbox { aspect-ratio: 1/0.7; display: flex; align-items: center; justify-content: center; position: relative; background: var(--itkaarhus-white); }
  .m .mbox::after { content: "✕"; position: absolute; top: 8px; right: 10px; color: var(--itkaarhus-danger-500); font-weight: 700; font-size: 18px; }
  .m img { max-width: 60%; max-height: 70%; object-fit: contain; }
  .m.stretch img { transform: scaleX(1.6); }
  .m.tint { filter: hue-rotate(220deg) saturate(2); }
  .m.shadow img { filter: drop-shadow(4px 4px 0 rgba(0,0,0,.4)); }
  .m.bg .mbox { background: linear-gradient(45deg, #ff0080, #ffa200); }
  .m .cap { padding: 10px 14px; font-size: 12px; color: var(--itkaarhus-text-muted); border-top: 1px solid var(--itkaarhus-border); }

  .clearspace { background: var(--itkaarhus-gray-50); border: 1px solid var(--itkaarhus-border); border-radius: 12px; padding: 48px; display: flex; align-items: center; justify-content: center; position: relative; }
  .clearspace .rel { position: relative; display: inline-block; }
  .clearspace .rel img { display: block; width: 360px; }
  .clearspace .rel::before { content: ""; position: absolute; inset: -25% ; border: 1px dashed var(--itkaarhus-info-500); border-radius: 4px; pointer-events: none; }
  .clearspace .rel::after { content: "X"; position: absolute; top: -11px; left: 50%; transform: translateX(-50%); background: var(--itkaarhus-gray-50); padding: 0 6px; font-size: 11px; font-family: var(--itkaarhus-font-mono); color: var(--itkaarhus-info-500); }

  .cobrand { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: stretch; }
  .cobox { background: var(--itkaarhus-gray-900); color: var(--itkaarhus-white); padding: 32px; border-radius: 12px; display: flex; justify-content: space-between; align-items: center; gap: 32px; min-height: 120px; }
  .cobox.inv { background: var(--itkaarhus-white); color: var(--itkaarhus-gray-900); border: 1px solid var(--itkaarhus-border); }
  .cobox .div { width: 1px; height: 60%; background: currentColor; opacity: 0.3; }
  .cobox img { height: 48px; object-fit: contain; }

  @media (max-width: 860px) {
    .page { padding: 40px 20px; }
    .variants, .misuse, .cobrand, .dark-demo { grid-template-columns: 1fr; }
  }
</style>
